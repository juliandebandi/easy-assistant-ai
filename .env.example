# Copy to .env and fill in real values. .env is gitignored — nothing here should ever be a
# real credential; this file exists so `git clone` + `cp .env.example .env` is enough to know
# what the app needs to run, without hunting through config.py for every field.

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=DEBUG

# postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
# Host-side DSN; docker-compose.yml rewrites the host to "db" for containers on its network.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/backend
# Must match the credentials embedded in DATABASE_URL above — see .env's comment on why these
# are kept as separate vars instead of derived from the DSN.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=backend

GEMINI_API_KEY=
NOTION_API_KEY=
